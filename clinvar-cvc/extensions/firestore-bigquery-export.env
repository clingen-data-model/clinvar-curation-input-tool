ALLOWED_EVENT_TYPES=firebase.extensions.firestore-counter.v1.onStart
BIGQUERY_PROJECT_ID=clingen-cvc
COLLECTION_PATH=clinvar_cvc_ext_annotations
DATABASE=(default)
DATABASE_REGION=nam5
DATASET_ID=clinvar_cvc_ext
DATASET_LOCATION=us-central1
EVENTARC_CHANNEL=projects/${param:PROJECT_ID}/locations/us-central1/channels/firebase
EXCLUDE_OLD_DATA=yes
firebaseextensions.v1beta.function/ingressSettings=ALLOW_ALL
firebaseextensions.v1beta.function/location=us-central1
firebaseextensions.v1beta.function/memory=128
firebaseextensions.v1beta.function/minInstances=0
firebaseextensions.v1beta.function/vpcConnectorEgressSettings=VPC_CONNECTOR_EGRESS_SETTINGS_UNSPECIFIED
firebaseextensions.v1beta.v2function/memory=128Mi
LOG_LEVEL=debug
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
TABLE_ID=annotations
TABLE_PARTITIONING=NONE
TIME_PARTITIONING_FIELD_TYPE=omit
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
VIEW_TYPE=view
WILDCARD_IDS=false