{
  "manifest_version": 3,
  "name": "ClinVar Curator (CvC)",
  "version": "4.0",
  "description": "Capture ClinGen ClinVar SCV curation annotations to Firestore/BigQuery.",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "ClinVar POC",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "permissions": [
    "identity",
    "identity.email",
    "storage",
    "activeTab",
    "tabs"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "oauth2": {
    "client_id": "493724081911-56lforiqkeq2ahpip4ur6t315qc93ujf.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },

  "host_permissions": [
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://www.ncbi.nlm.nih.gov/clinvar/variation/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://www.ncbi.nlm.nih.gov/clinvar/variation/*"],
      "js": ["scv-sections.js", "scrape.js", "vocab.js", "annotation.js", "popup-view.js", "highlight.js", "dom-seams.js", "content.js"],
      "css": ["highlight.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
