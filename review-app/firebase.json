{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "/api/**", "function": "api" }],
    "headers": [
      {
        "source": "@(/|**/*.@(js|css|html))",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs20" }
}
